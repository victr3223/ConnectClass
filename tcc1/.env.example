# Modelo público. npm start carrega .env; variáveis do processo prevalecem.
# Nunca versionar valores reais. Use conta própria, não root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=connectclass_app
DB_PASSWORD=
DB_NAME=connectclass
HOST=127.0.0.1
PORT=8080
NODE_ENV=development
# Obrigatória SOMENTE se ainda não existir gestor; não redefine senha existente.
# Para migrar uma base antiga, execute a importação ANTES do primeiro start.
CONNECTCLASS_GESTOR_PASSWORD=
