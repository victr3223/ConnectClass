# Copie para .env.mysql-admin e preencha localmente. Nunca versionar valores reais.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# db:init usa um banco existente, dedicado ao ConnectClass.
DB_NAME=connectclass_final
DB_SSL=false
# DB_SSL_CA= (CA PEM do provedor, somente se necessária e com DB_SSL=true)
