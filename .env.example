# Modelo NATIVO sem credenciais. O runtime carrega .env nesta pasta.
# Docker: npm run docker:configure gera .env.docker.app e .env.docker.mysql
# privados e separados, sem sobrescrever este ambiente nativo.
# Compose fixa DB_HOST=mysql, DB_PORT=3306, DB_NAME=connectclass e HOST=0.0.0.0.
# Opções de publicação Docker (sem senhas):
# APP_PORT=8081
# APP_BIND=127.0.0.1
# APP_NODE_ENV=development  (production somente atrás de HTTPS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=connectclass_final_app
DB_PASSWORD=
DB_NAME=connectclass_final
DB_SSL=false
# DB_SSL_CA= (CA PEM do provedor; requer DB_SSL=true)
# Em produção: NODE_ENV=production, HOST=0.0.0.0 e PORT fornecida pelo host.
HOST=127.0.0.1
PORT=8081
NODE_ENV=development
# Somente para criar gestor em uma base NOVA; não redefine gestor existente.
# Importe a base legada antes do primeiro start, se houver dados a preservar.
CONNECTCLASS_GESTOR_PASSWORD=
