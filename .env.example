# Modelo sem credenciais. O runtime carrega .env nesta pasta.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=connectclass_final_app
DB_PASSWORD=
DB_NAME=connectclass_final
DB_SSL=false
# DB_SSL_CA= (CA PEM do provedor; requer DB_SSL=true)
# Em produção: NODE_ENV=production, HOST=0.0.0.0 e PORT fornecida pelo host.
HOST=127.0.0.1
PORT=8081
NODE_ENV=development
# Somente para criar gestor em uma base NOVA; não redefine gestor existente.
# Importe a base legada antes do primeiro start, se houver dados a preservar.
CONNECTCLASS_GESTOR_PASSWORD=
